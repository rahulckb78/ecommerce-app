{
  "name": "ecommerce-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"vite\" \"nodemon server/index.js\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/migrate-auth.js && node server/migrate.js",
    "seed": "node server/seed.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
